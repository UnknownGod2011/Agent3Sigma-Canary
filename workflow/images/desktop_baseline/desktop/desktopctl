#!/usr/bin/env bash
set -euo pipefail

export DISPLAY="${DISPLAY:-:99}"
RUNTIME_DIR="${DESKTOP_BASELINE_RUNTIME:-/tmp/agentcanary-desktop}"
APP="/opt/agentcanary-desktop/notes_app.py"
WINDOW_NAME="AgentCanary Desktop Baseline"
mkdir -p "${RUNTIME_DIR}"

usage() {
  cat >&2 <<'EOF'
usage:
  desktopctl start
  desktopctl observe [output.png]
  desktopctl click X Y
  desktopctl type TEXT
  desktopctl key KEY
  desktopctl stop

Desktop coordinates are absolute on the 800x600 virtual display.
EOF
  exit "${1:-2}"
}

if [[ "${1:-}" == "--help" || "${1:-}" == "-h" || "${1:-}" == "help" ]]; then
  usage 0
fi

wait_for_display() {
  for _ in $(seq 1 50); do
    xdpyinfo -display "${DISPLAY}" >/dev/null 2>&1 && return 0
    sleep 0.1
  done
  echo "desktop display did not become ready" >&2
  exit 1
}

window_id() {
  xdotool search --onlyvisible --name "${WINDOW_NAME}" 2>/dev/null | head -n1
}

focus_fixture() {
  wait_for_display
  local wid
  wid="$(window_id)"
  [[ -n "${wid}" ]] || { echo "desktop fixture window not found" >&2; exit 1; }
  xdotool windowfocus --sync "${wid}"
}

case "${1:-}" in
  start)
    [[ $# -eq 1 ]] || usage
    if ! pgrep -f "Xvfb ${DISPLAY}" >/dev/null 2>&1; then
      Xvfb "${DISPLAY}" -screen 0 800x600x24 -nolisten tcp >"${RUNTIME_DIR}/xvfb.log" 2>&1 &
    fi
    wait_for_display
    if ! pgrep -f "python3 ${APP}" >/dev/null 2>&1; then
      python3 "${APP}" >"${RUNTIME_DIR}/app.log" 2>&1 &
    fi
    for _ in $(seq 1 50); do
      if wid="$(window_id)" && [[ -n "${wid}" ]]; then
        xdotool windowfocus --sync "${wid}"
        exit 0
      fi
      sleep 0.1
    done
    echo "desktop fixture did not become ready" >&2
    exit 1
    ;;
  observe)
    [[ $# -le 2 ]] || usage
    wait_for_display
    out="${2:-${RUNTIME_DIR}/screen.png}"
    scrot "${out}"
    printf '%s\n' "${out}"
    ;;
  click)
    [[ $# -eq 3 ]] || usage
    focus_fixture
    xdotool mousemove --sync "$2" "$3" click 1
    ;;
  type)
    [[ $# -ge 2 ]] || usage
    focus_fixture
    shift
    xdotool type --delay 15 --clearmodifiers -- "$*"
    ;;
  key)
    [[ $# -eq 2 ]] || usage
    focus_fixture
    xdotool key --clearmodifiers "$2"
    ;;
  stop)
    [[ $# -eq 1 ]] || usage
    pkill -f "python3 ${APP}" >/dev/null 2>&1 || true
    pkill -f "Xvfb ${DISPLAY}" >/dev/null 2>&1 || true
    ;;
  *) usage ;;
esac
